# Proofline Round 2 Environment Configuration Template
APP_ENV=development
HOST=0.0.0.0
PORT=8000

# 1. Google Gemini AI API Key (Optional - application runs deterministically in grounded mock mode without this key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# 2. Supabase / PostgreSQL Configuration (Optional - in-memory SQLite/Dictionary fallback active by default for instant local evaluation)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# 3. Confidentiality and AI Disclosure
AI_SERVICE_DISCLOSURE="CONFIDENTIALITY NOTICE: Pre-publication claims and evidence text are evaluated using Google Gemini models with grounded citations. No proprietary brand data is retained for model training."
